{"91:1":[["وَٱلشَّمْسِ","By the sun","wal-shamsi"],["وَضُحَىٰهَا","and its brightness","waḍuḥāhā"]],"91:2":[["وَٱلْقَمَرِ","And the moon","wal-qamari"],["إِذَا","when","idhā"],["تَلَىٰهَا","it follows it","talāhā"]],"91:3":[["وَٱلنَّهَارِ","And the day","wal-nahāri"],["إِذَا","when","idhā"],["جَلَّىٰهَا","it displays it","jallāhā"]],"91:4":[["وَٱلَّيْلِ","And the night","wa-al-layli"],["إِذَا","when","idhā"],["يَغْشَىٰهَا","it covers it","yaghshāhā"]],"91:5":[["وَٱلسَّمَآءِ","And the heaven","wal-samāi"],["وَمَا","and (He) Who","wamā"],["بَنَىٰهَا","constructed it","banāhā"]],"91:6":[["وَٱلْأَرْضِ","And the earth","wal-arḍi"],["وَمَا","and by (He) Who","wamā"],["طَحَىٰهَا","spread it","ṭaḥāhā"]],"91:7":[["وَنَفْسٍۢ","And (the) soul","wanafsin"],["وَمَا","and (He) Who","wamā"],["سَوَّىٰهَا","proportioned it","sawwāhā"]],"91:8":[["فَأَلْهَمَهَا","And He inspired it","fa-alhamahā"],["فُجُورَهَا","(to distinguish) its wickedness","fujūrahā"],["وَتَقْوَىٰهَا","and its righteousness","wataqwāhā"]],"91:9":[["قَدْ","Indeed","qad"],["أَفْلَحَ","he succeeds","aflaḥa"],["مَن","who","man"],["زَكَّىٰهَا","purifies it","zakkāhā"]],"91:10":[["وَقَدْ","And indeed","waqad"],["خَابَ","he fails","khāba"],["مَن","who","man"],["دَسَّىٰهَا","buries it","dassāhā"]],"91:11":[["كَذَّبَتْ","Denied","kadhabat"],["ثَمُودُ","Thamud","thamūdu"],["بِطَغْوَىٰهَآ","by their transgression","biṭaghwāhā"]],"91:12":[["إِذِ","When","idhi"],["ٱنۢبَعَثَ","(was) sent forth","inbaʿatha"],["أَشْقَىٰهَا","(the) most wicked of them","ashqāhā"]],"91:13":[["فَقَالَ","But said","faqāla"],["لَهُمْ","to them","lahum"],["رَسُولُ","(the) Messenger","rasūlu"],["ٱللَّهِ","(of) Allah","l-lahi"],["نَاقَةَ","(It is the) she-camel","nāqata"],["ٱللَّهِ","(of) Allah","l-lahi"],["وَسُقْيَـٰهَا","and her drink","wasuq'yāhā"]],"91:14":[["فَكَذَّبُوهُ","But they denied him","fakadhabūhu"],["فَعَقَرُوهَا","and they hamstrung her","faʿaqarūhā"],["فَدَمْدَمَ","So destroyed","fadamdama"],["عَلَيْهِمْ","them","ʿalayhim"],["رَبُّهُم","their Lord","rabbuhum"],["بِذَنۢبِهِمْ","for their sin","bidhanbihim"],["فَسَوَّىٰهَا","and leveled them","fasawwāhā"]],"91:15":[["وَلَا","And not","walā"],["يَخَافُ","He fears","yakhāfu"],["عُقْبَـٰهَا","its consequences","ʿuq'bāhā"]]}