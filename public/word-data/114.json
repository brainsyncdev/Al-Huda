{"114:1":[["قُلْ","Say","qul"],["أَعُوذُ","I seek refuge","aʿūdhu"],["بِرَبِّ","in (the) Lord","birabbi"],["ٱلنَّاسِ","(of) mankind","l-nāsi"]],"114:2":[["مَلِكِ","(The) King","maliki"],["ٱلنَّاسِ","(of) mankind","l-nāsi"]],"114:3":[["إِلَـٰهِ","(The) God","ilāhi"],["ٱلنَّاسِ","(of) mankind","l-nāsi"]],"114:4":[["مِن","From","min"],["شَرِّ","(the) evil","sharri"],["ٱلْوَسْوَاسِ","(of) the whisperer","l-waswāsi"],["ٱلْخَنَّاسِ","the one who withdraws","l-khanāsi"]],"114:5":[["ٱلَّذِى","The one who","alladhī"],["يُوَسْوِسُ","whispers","yuwaswisu"],["فِى","in","fī"],["صُدُورِ","(the) breasts","ṣudūri"],["ٱلنَّاسِ","(of) mankind","l-nāsi"]],"114:6":[["مِنَ","From","mina"],["ٱلْجِنَّةِ","the jinn","l-jinati"],["وَٱلنَّاسِ","and men","wal-nāsi"]]}