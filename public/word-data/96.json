{"96:1":[["ٱقْرَأْ","Read","iq'ra"],["بِٱسْمِ","in (the) name","bi-is'mi"],["رَبِّكَ","(of) your Lord","rabbika"],["ٱلَّذِى","the One Who","alladhī"],["خَلَقَ","created ","khalaqa"]],"96:2":[["خَلَقَ","He created","khalaqa"],["ٱلْإِنسَـٰنَ","man","l-insāna"],["مِنْ","from","min"],["عَلَقٍ","a clinging substance","ʿalaqin"]],"96:3":[["ٱقْرَأْ","Read","iq'ra"],["وَرَبُّكَ","and your Lord","warabbuka"],["ٱلْأَكْرَمُ","(is) the Most Generous","l-akramu"]],"96:4":[["ٱلَّذِى","The One Who","alladhī"],["عَلَّمَ","taught","ʿallama"],["بِٱلْقَلَمِ","by the pen","bil-qalami"]],"96:5":[["عَلَّمَ","Taught","ʿallama"],["ٱلْإِنسَـٰنَ","man","l-insāna"],["مَا","what","mā"],["لَمْ","not","lam"],["يَعْلَمْ","he knew","yaʿlam"]],"96:6":[["كَلَّآ","Nay","kallā"],["إِنَّ","Indeed","inna"],["ٱلْإِنسَـٰنَ","man","l-insāna"],["لَيَطْغَىٰٓ","surely transgresses","layaṭghā"]],"96:7":[["أَن","That","an"],["رَّءَاهُ","he sees himself","raāhu"],["ٱسْتَغْنَىٰٓ","self-sufficient","is'taghnā"]],"96:8":[["إِنَّ","Indeed","inna"],["إِلَىٰ","to","ilā"],["رَبِّكَ","your Lord","rabbika"],["ٱلرُّجْعَىٰٓ","(is) the return","l-ruj'ʿā"]],"96:9":[["أَرَءَيْتَ","Have you seen","ara-ayta"],["ٱلَّذِى","the one who","alladhī"],["يَنْهَىٰ","forbids","yanhā"]],"96:10":[["عَبْدًا","A slave","ʿabdan"],["إِذَا","when","idhā"],["صَلَّىٰٓ","he prays","ṣallā"]],"96:11":[["أَرَءَيْتَ","Have you seen","ara-ayta"],["إِن","if","in"],["كَانَ","he is","kāna"],["عَلَى","upon","ʿalā"],["ٱلْهُدَىٰٓ","[the] guidance","l-hudā"]],"96:12":[["أَوْ","Or","aw"],["أَمَرَ","he enjoins","amara"],["بِٱلتَّقْوَىٰٓ","[of the] righteousness","bil-taqwā"]],"96:13":[["أَرَءَيْتَ","Have you seen","ara-ayta"],["إِن","if","in"],["كَذَّبَ","he denies","kadhaba"],["وَتَوَلَّىٰٓ","and turns away","watawallā"]],"96:14":[["أَلَمْ","Does not","alam"],["يَعْلَم","he know","yaʿlam"],["بِأَنَّ","that","bi-anna"],["ٱللَّهَ","Allah","l-laha"],["يَرَىٰ","sees","yarā"]],"96:15":[["كَلَّا","Nay","kallā"],["لَئِن","If","la-in"],["لَّمْ","not","lam"],["يَنتَهِ