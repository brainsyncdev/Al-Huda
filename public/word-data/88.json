{"88:1":[["هَلْ","Has","hal"],["أَتَىٰكَ","(there) come to you","atāka"],["حَدِيثُ","(the) news","ḥadīthu"],["ٱلْغَـٰشِيَةِ","(of) the Overwhelming","l-ghāshiyati"]],"88:2":[["وُجُوهٌۭ","Faces","wujūhun"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["خَـٰشِعَةٌ","(will be) humbled","khāshiʿatun"]],"88:3":[["عَامِلَةٌۭ","Laboring","ʿāmilatun"],["نَّاصِبَةٌۭ","exhausted","nāṣibatun"]],"88:4":[["تَصْلَىٰ","They will burn","taṣlā"],["نَارًا","(in) a Fire","nāran"],["حَامِيَةًۭ","intensely hot","ḥāmiyatan"]],"88:5":[["تُسْقَىٰ","They will be given to drink","tus'qā"],["مِنْ","from","min"],["عَيْنٍ","a spring","ʿaynin"],["ءَانِيَةٍۢ","boiling","āniyatin"]],"88:6":[["لَّيْسَ","Not is","laysa"],["لَهُمْ","for them","lahum"],["طَعَامٌ","food","ṭaʿāmun"],["إِلَّا","except","illā"],["مِن","from","min"],["ضَرِيعٍۢ","a bitter thorny plant","ḍarīʿin"]],"88:7":[["لَّا","Not","lā"],["يُسْمِنُ","it nourishes","yus'minu"],["وَلَا","and not","walā"],["يُغْنِى","it avails","yugh'nī"],["مِن","from","min"],["جُوعٍۢ","hunger","jūʿin"]],"88:8":[["وُجُوهٌۭ","Faces","wujūhun"],["يَوْمَئِذٍۢ","that Day","yawma-idhin"],["نَّاعِمَةٌۭ","(will be) joyful","nāʿimatun"]],"88:9":[["لِّسَعْيِهَا","With their effort","lisaʿyihā"],["رَاضِيَةٌۭ","satisfied","rāḍiyatun"]],"88:10":[["فِى","In","fī"],["جَنَّةٍ","a garden","jannatin"],["عَالِيَةٍۢ","elevated","ʿāliyatin"]],"88:11":[["لَّا","Not","lā"],["تَسْمَعُ","they will hear","tasmaʿu"],["فِيهَا","therein","fīhā"],["لَـٰغِيَةًۭ","vain talk","lāghiyatan"]],"88:12":[["فِيهَا","Therein","fīhā"],["عَيْنٌۭ","(will be) a spring","ʿaynun"],["جَارِيَةٌۭ","flowing","jāriyatun"]],"88:13":[["فِيهَا","Therein","fīhā"],["سُرُرٌۭ","(will be) thrones","sururun"],["مَّرْفُوعَةٌۭ","raised high","marfūʿatun"]],"88:14":[["وَأَكْوَابٌۭ","And cups","wa-akwābun"],["مَّوْضُوعَةٌۭ","put in place","mawḍūʿatun"]],"88:15":[["وَنَمَارِقُ","And cushions","wanamāriqu"],["مَصْفُوفَةٌۭ","lined up","maṣfūfatun"]],"88:16":[["وَزَرَابِىُّ","And carpets","wazarābiyyu"],["مَبْثُوثَةٌ","spread out","mabthūthatun"]],"88:17":[["أَفَلَا","Then do not","afalā"],["يَنظُرُونَ","they look","yanẓurūna"],["إِلَى","towards","ilā"],["ٱلْإِبِلِ","the camels","l-ibili"],["كَيْفَ","how","kayfa"],["خُلِقَتْ","they are created","khuliqat"]],"88:18":[["وَإِلَى","And towards","wa-ilā"],["ٱلسَّمَآءِ","the sky","l-samāi"],["كَيْفَ","how","kayfa"],["رُفِعَتْ","it is raised","rufiʿat"]],"88:19":[["وَإِلَى","And towards","wa-ilā"],["ٱلْجِبَالِ","the mountains","l-jibāli"],["كَيْفَ","how","kayfa"],["نُصِبَتْ","they are fixed","nuṣibat"]],"88:20":[["وَإِلَى","And towards","wa-ilā"],["ٱلْأَرْضِ","the earth","l-arḍi"],["كَيْفَ","how","kayfa"],["سُطِحَتْ","it is spread out","suṭiḥat"]],"88:21":[["فَذَكِّرْ","So remind","fadhakkir"],["إِنَّمَآ","only","innamā"],["أَنتَ","you","anta"],["مُذَكِّرٌۭ","(are) a reminder","mudhakkirun"]],"88:22":[["لَّسْتَ","You are not","lasta"],["عَلَيْهِم","over them","ʿalayhim"],["بِمُصَيْطِرٍ","a controller","bimuṣayṭirin"]],"88:23":[["إِلَّا","But","illā"],["مَن","whoever","man"],["تَوَلَّىٰ","turns away","tawallā"],["وَكَفَرَ","and disbelieves","wakafara"]],"88:24":[["فَيُعَذِّبُهُ","Then will punish him","fayuʿadhibuhu"],["ٱللَّهُ","Allah","l-lahu"],["ٱلْعَذَابَ","(with) the punishment","l-ʿadhāba"],["ٱلْأَكْبَرَ","greatest","l-akbara"]],"88:25":[["إِنَّ","Indeed","inna"],["إِلَيْنَآ","to Us","ilaynā"],["إِيَابَهُمْ","(will be) their return","iyābahum"]],"88:26":[["ثُمَّ","Then","thumma"],["إِنَّ","indeed","inna"],["عَلَيْنَا","upon Us","ʿalaynā"],["حِسَابَهُم","(is) their account","ḥisābahum"]]}