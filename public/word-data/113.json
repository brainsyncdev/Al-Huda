{"113:1":[["قُلْ","Say","qul"],["أَعُوذُ","I seek refuge","aʿūdhu"],["بِرَبِّ","in (the) Lord","birabbi"],["ٱلْفَلَقِ","(of) the dawn","l-falaqi"]],"113:2":[["مِن","From","min"],["شَرِّ","(the) evil","sharri"],["مَا","(of) what","mā"],["خَلَقَ","He created","khalaqa"]],"113:3":[["وَمِن","And from","wamin"],["شَرِّ","(the) evil","sharri"],["غَاسِقٍ","(of) darkness","ghāsiqin"],["إِذَا","when","idhā"],["وَقَبَ","it spreads","waqaba"]],"113:4":[["وَمِن","And from","wamin"],["شَرِّ","(the) evil","sharri"],["ٱلنَّفَّـٰثَـٰتِ","(of) the blowers","l-nafāthāti"],["فِى","in","fī"],["ٱلْعُقَدِ","the knots","l-ʿuqadi"]],"113:5":[["وَمِن","And from","wamin"],["شَرِّ","(the) evil","sharri"],["حَاسِدٍ","(of) an envier","ḥāsidin"],["إِذَا","when","idhā"],["حَسَدَ","he envies","ḥasada"]]}