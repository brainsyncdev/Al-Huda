{"83:1":[["وَيْلٌۭ","Woe","waylun"],["لِّلْمُطَفِّفِينَ","to those who give less","lil'muṭaffifīna"]],"83:2":[["ٱلَّذِينَ","Those who","alladhīna"],["إِذَا","when","idhā"],["ٱكْتَالُوا۟","they take a measure","ik'tālū"],["عَلَى","from","ʿalā"],["ٱلنَّاسِ","the people","l-nāsi"],["يَسْتَوْفُونَ","they take in full","yastawfūna"]],"83:3":[["وَإِذَا","But when","wa-idhā"],["كَالُوهُمْ","they give by measure (to) them","kālūhum"],["أَو","or","aw"],["وَّزَنُوهُمْ","they weigh (for) them","wazanūhum"],["يُخْسِرُونَ","they give less","yukh'sirūna"]],"83:4":[["أَلَا","Do not","alā"],["يَظُنُّ","think","yaẓunnu"],["أُو۟لَـٰٓئِكَ","those","ulāika"],["أَنَّهُم","that they","annahum"],["مَّبْعُوثُونَ","(will be) resurrected","mabʿūthūna"]],"83:5":[["لِيَوْمٍ","For a Day","liyawmin"],["عَظِيمٍۢ","Great","ʿaẓīmin"]],"83:6":[["يَوْمَ","(The) Day","yawma"],["يَقُومُ","will stand","yaqūmu"],["ٱلنَّاسُ","mankind","l-nāsu"],["لِرَبِّ","before (the) Lord","lirabbi"],["ٱلْعَـٰلَمِينَ","(of) the worlds","l-ʿālamīna"]],"83:7":[["كَلَّآ","Nay","kallā"],["إِنَّ","Indeed","inna"],["كِتَـٰبَ","(the) record","kitāba"],["ٱلْفُجَّارِ","(of) the wicked","l-fujāri"],["لَفِى","(is) surely in","lafī"],["سِجِّينٍۢ","Sijjin","sijjīnin"]],"83:8":[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","can make you know","adrāka"],["مَا","what","mā"],["سِجِّينٌۭ","(is) Sijjin","sijjīnun"]],"83:9":[["كِتَـٰبٌۭ","A book","kitābun"],["مَّرْقُومٌۭ","written","marqūmun"]],"83:10":[["وَيْلٌۭ","Woe","waylun"],["يَوْمَئِذٍۢ","that Day","yawma-idhin"],["لِّلْمُكَذِّبِينَ","to the deniers","lil'mukadhibīna"]],"83:11":[["ٱلَّذِينَ","Those who","alladhīna"],["يُكَذِّبُونَ","deny","yukadhibūna"],["بِيَوْمِ","(the) Day","biyawmi"],["ٱلدِّينِ","(of) the Judgment","l-dīni"]],"83:12":[["وَمَا","And not","wamā"],["يُكَذِّبُ","can deny","yukadhibu"],["بِهِۦٓ","[of] it","bihi"],["إِلَّا","except","illā"],["كُلُّ","every","kullu"],["مُعْتَدٍ","transgressor","muʿ'tadin"],["أَثِيمٍ","sinful","athīmin"]],"83:13":[["إِذَا","When","idhā"],