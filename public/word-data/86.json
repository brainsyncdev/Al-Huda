{"86:1":[["وَٱلسَّمَآءِ","By the sky","wal-samāi"],["وَٱلطَّارِقِ","and the night comer","wal-ṭāriqi"]],"86:2":[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","can make you know","adrāka"],["مَا","what","mā"],["ٱلطَّارِقُ","the night comer (is)","l-ṭāriqu"]],"86:3":[["ٱلنَّجْمُ","(It is) the star","al-najmu"],["ٱلثَّاقِبُ","the piercing","l-thāqibu"]],"86:4":[["إِن","Not","in"],["كُلُّ","(is) every","kullu"],["نَفْسٍۢ","soul","nafsin"],["لَّمَّا","but","lammā"],["عَلَيْهَا","over it","ʿalayhā"],["حَافِظٌۭ","(is) a protector","ḥāfiẓun"]],"86:5":[["فَلْيَنظُرِ","So let see","falyanẓuri"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["مِمَّ","from what","mimma"],["خُلِقَ","he is created","khuliqa"]],"86:6":[["خُلِقَ","He is created","khuliqa"],["مِن","from","min"],["مَّآءٍۢ","a water","māin"],["دَافِقٍۢ","ejected","dāfiqin"]],"86:7":[["يَخْرُجُ","Coming forth","yakhruju"],["مِنۢ","from","min"],["بَيْنِ","between","bayni"],["ٱلصُّلْبِ","the backbone","l-ṣul'bi"],["وَٱلتَّرَآئِبِ","and the ribs","wal-tarāibi"]],"86:8":[["إِنَّهُۥ","Indeed, He","innahu"],["عَلَىٰ","to","ʿalā"],["رَجْعِهِۦ","return him","rajʿihi"],["لَقَادِرٌۭ","(is) Able","laqādirun"]],"86:9":[["يَوْمَ","(The) Day","yawma"],["تُبْلَى","will be tested","tub'lā"],["ٱلسَّرَآئِرُ","the secrets","l-sarāiru"]],"86:10":[["فَمَا","Then not","famā"],["لَهُۥ","(is) for him","lahu"],["مِن","any","min"],["قُوَّةٍۢ","power","quwwatin"],["وَلَا","and not","walā"],["نَاصِرٍۢ","any helper","nāṣirin"]],"86:11":[["وَٱلسَّمَآءِ","By the sky","wal-samāi"],["ذَاتِ","which","dhāti"],["ٱلرَّجْعِ","returns","l-rajʿi"]],"86:12":[["وَٱلْأَرْضِ","And the earth","wal-arḍi"],["ذَاتِ","which","dhāti"],["ٱلصَّدْعِ","cracks open","l-ṣadʿi"]],"86:13":[["إِنَّهُۥ","Indeed, it","innahu"],["لَقَوْلٌۭ","(is) surely a Word","laqawlun"],["فَصْلٌۭ","decisive","faṣlun"]],"86:14":[["وَمَا","And not","wamā"],["هُوَ","it","huwa"],["بِٱلْهَزْلِ","(is) for amusement","bil-hazli"]],"86:15":[["إِنَّهُمْ","Indeed, they","innahum"],["يَكِيدُونَ","are plotting","yakīdūna"],["كَيْدًۭا","a plot","kaydan"]],"86:16":[["وَأَكِيدُ","But I am planning","wa-akīdu"],["كَيْدًۭا","a plan","kaydan"]],"86:17":[["فَمَهِّلِ","So give respite","famahhili"],["ٱلْكَـٰفِرِينَ","(to) the disbelievers","l-kāfirīna"],["أَمْهِلْهُمْ","Give respite to them ","amhil'hum"],["رُوَيْدًۢا","little","ruwaydan"]]}