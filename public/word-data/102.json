{"102:1":[["أَلْهَىٰكُمُ","Diverts you","alhākumu"],["ٱلتَّكَاثُرُ","the competition to increase","l-takāthuru"]],"102:2":[["حَتَّىٰ","Until","ḥattā"],["زُرْتُمُ","you visit","zur'tumu"],["ٱلْمَقَابِرَ","the graves","l-maqābira"]],"102:3":[["كَلَّا","Nay","kallā"],["سَوْفَ","Soon","sawfa"],["تَعْلَمُونَ","you will know","taʿlamūna"]],"102:4":[["ثُمَّ","Then","thumma"],["كَلَّا","nay","kallā"],["سَوْفَ","Soon","sawfa"],["تَعْلَمُونَ","you will know","taʿlamūna"]],"102:5":[["كَلَّا","Nay","kallā"],["لَوْ","If","law"],["تَعْلَمُونَ","you know","taʿlamūna"],["عِلْمَ","(with) a knowledge","ʿil'ma"],["ٱلْيَقِينِ","(of) certainty","l-yaqīni"]],"102:6":[["لَتَرَوُنَّ","Surely you will see","latarawunna"],["ٱلْجَحِيمَ","the Hellfire","l-jaḥīma"]],"102:7":[["ثُمَّ","Then","thumma"],["لَتَرَوُنَّهَا","surely you will see it","latarawunnahā"],["عَيْنَ","(with the) eye","ʿayna"],["ٱلْيَقِينِ","(of) certainty","l-yaqīni"]],"102:8":[["ثُمَّ","Then","thumma"],["لَتُسْـَٔلُنَّ","surely you will be asked","latus'alunna"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["عَنِ","about","ʿani"],["ٱلنَّعِيمِ","the pleasures","l-naʿīmi"]]}