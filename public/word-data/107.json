{"107:1":[["أَرَءَيْتَ","Have you seen","ara-ayta"],["ٱلَّذِى","the one who","alladhī"],["يُكَذِّبُ","denies","yukadhibu"],["بِٱلدِّينِ","the Judgment","bil-dīni"]],"107:2":[["فَذَٰلِكَ","Then that","fadhālika"],["ٱلَّذِى","(is) the one who","alladhī"],["يَدُعُّ","repulses","yaduʿʿu"],["ٱلْيَتِيمَ","the orphan","l-yatīma"]],"107:3":[["وَلَا","And (does) not","walā"],["يَحُضُّ","feel the urge","yaḥuḍḍu"],["عَلَىٰ","to","ʿalā"],["طَعَامِ","feed","ṭaʿāmi"],["ٱلْمِسْكِينِ","the poor","l-mis'kīni"]],"107:4":[["فَوَيْلٌۭ","So woe","fawaylun"],["لِّلْمُصَلِّينَ","to those who pray","lil'muṣallīna"]],"107:5":[["ٱلَّذِينَ","Those who","alladhīna"],["هُمْ","[they]","hum"],["عَن","about","ʿan"],["صَلَاتِهِمْ","their prayers","ṣalātihim"],["سَاهُونَ","(are) neglectful","sāhūna"]],"107:6":[["ٱلَّذِينَ","Those who","alladhīna"],["هُمْ","[they]","hum"],["يُرَآءُونَ","make show","yurāūna"]],"107:7":[["وَيَمْنَعُونَ","And they deny","wayamnaʿūna"],["ٱلْمَاعُونَ","[the] small kindnesses","l-māʿūna"]]}