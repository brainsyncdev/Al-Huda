{"55:1":[["ٱلرَّحْمَـٰنُ","The Most Gracious","al-raḥmānu"]],"55:2":[["عَلَّمَ","He taught","ʿallama"],["ٱلْقُرْءَانَ","the Quran","l-qur'āna"]],"55:3":[["خَلَقَ","He created","khalaqa"],["ٱلْإِنسَـٰنَ","[the] man","l-insāna"]],"55:4":[["عَلَّمَهُ","He taught him","ʿallamahu"],["ٱلْبَيَانَ","[the] speech","l-bayāna"]],"55:5":[["ٱلشَّمْسُ","The sun","al-shamsu"],["وَٱلْقَمَرُ","and the moon","wal-qamaru"],["بِحُسْبَانٍۢ","by (precise) calculation","biḥus'bānin"]],"55:6":[["وَٱلنَّجْمُ","And the stars","wal-najmu"],["وَٱلشَّجَرُ","and the trees","wal-shajaru"],["يَسْجُدَانِ","both prostrate","yasjudāni"]],"55:7":[["وَٱلسَّمَآءَ","And the heaven","wal-samāa"],["رَفَعَهَا","He raised it","rafaʿahā"],["وَوَضَعَ","and He has set up","wawaḍaʿa"],["ٱلْمِيزَانَ","the balance","l-mīzāna"]],"55:8":[["أَلَّا","That not","allā"],["تَطْغَوْا۟","you may transgress","taṭghaw"],["فِى","in","fī"],["ٱلْمِيزَانِ","the balance","l-mīzāni"]],"55:9":[["وَأَقِيمُوا۟","And establish","wa-aqīmū"],["ٱلْوَزْنَ","the weight","l-wazna"],["بِٱلْقِسْطِ","in justice","bil-qis'ṭi"],["وَلَا","and (do) not","walā"],["تُخْسِرُوا۟","make deficient","tukh'sirū"],["ٱلْمِيزَانَ","the balance","l-mīzāna"]],"55:10":[["وَٱلْأَرْضَ","And the earth","wal-arḍa"],["وَضَعَهَا","He laid it","waḍaʿahā"],["لِلْأَنَامِ","for the creatures","lil'anāmi"]],"55:11":[["فِيهَا","Therein","fīhā"],["فَـٰكِهَةٌۭ","(is) fruit","fākihatun"],["وَٱلنَّخْلُ","and date-palms","wal-nakhlu"],["ذَاتُ","having","dhātu"],["ٱلْأَكْمَامِ","sheaths","l-akmāmi"]],"55:12":[["وَٱلْحَبُّ","And the grain","wal-ḥabu"],["ذُو","having","dhū"],["ٱلْعَصْفِ","husk","l-ʿaṣfi"],["وَٱلرَّيْحَانُ","and scented plants","wal-rayḥānu"]],"55:13":[["فَبِأَىِّ","So which","fabi-ayyi"],["ءَالَآءِ","(of the) favors","ālāi"],["رَبِّكُمَا","(of) your Lord","rabbikumā"],["تُكَذِّبَانِ","will you both deny","tukadhibāni"]],"55:14":[["خَلَقَ","He created","khalaqa"],["ٱلْإِنسَـٰنَ","the man","l-insāna"],["مِن","from","min"],["صَلْصَـٰلٍۢ","clay","ṣalṣālin"],["كَٱلْف