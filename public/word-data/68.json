{"68:1":[["نٓ ۚ","Nun","noon"],["وَٱلْقَلَمِ","By the pen","wal-qalami"],["وَمَا","and what","wamā"],["يَسْطُرُونَ","they write","yasṭurūna"]],"68:2":[["مَآ","Not","mā"],["أَنتَ","you (are)","anta"],["بِنِعْمَةِ","by (the) Grace","biniʿ'mati"],["رَبِّكَ","(of) your Lord","rabbika"],["بِمَجْنُونٍۢ","a madman","bimajnūnin"]],"68:3":[["وَإِنَّ","And indeed","wa-inna"],["لَكَ","for you","laka"],["لَأَجْرًا","surely (is) a reward","la-ajran"],["غَيْرَ","without","ghayra"],["مَمْنُونٍۢ","end","mamnūnin"]],"68:4":[["وَإِنَّكَ","And indeed, you","wa-innaka"],["لَعَلَىٰ","surely (are)","laʿalā"],["خُلُقٍ","(of) a moral character","khuluqin"],["عَظِيمٍۢ","great","ʿaẓīmin"]],"68:5":[["فَسَتُبْصِرُ","So you will see","fasatub'ṣiru"],["وَيُبْصِرُونَ","and they will see","wayub'ṣirūna"]],"68:6":[["بِأَييِّكُمُ","Which of you","bi-ayyikumu"],["ٱلْمَفْتُونُ","(is) the afflicted one","l-maftūnu"]],"68:7":[["إِنَّ","Indeed","inna"],["رَبَّكَ","your Lord","rabbaka"],["هُوَ","He","huwa"],["أَعْلَمُ","(is) most knowing","aʿlamu"],["بِمَن","of (he) who","biman"],["ضَلَّ","has strayed","ḍalla"],["عَن","from","ʿan"],["سَبِيلِهِۦ","His way","sabīlihi"],["وَهُوَ","and He","wahuwa"],["أَعْلَمُ","(is) most knowing","aʿlamu"],["بِٱلْمُهْتَدِينَ","of the guided ones","bil-muh'tadīna"]],"68:8":[["فَلَا","So (do) not","falā"],["تُطِعِ","obey","tuṭiʿi"],["ٱلْمُكَذِّبِينَ","the deniers","l-mukadhibīna"]],"68:9":[["وَدُّوا۟","They wish","waddū"],["لَوْ","that","law"],["تُدْهِنُ","you should compromise","tud'hinu"],["فَيُدْهِنُونَ","so they would compromise","fayud'hinūna"]],"68:10":[["وَلَا","And (do) not","walā"],["تُطِعْ","obey","tuṭiʿ"],["كُلَّ","every","kulla"],["حَلَّافٍۢ","habitual swearer","ḥallāfin"],["مَّهِينٍ","worthless","mahīnin"]],"68:11":[["هَمَّازٍۢ","Defamer","hammāzin"],["مَّشَّآءٍۭ","going about","mashāin"],["بِنَمِيمٍۢ","with malicious gossip","binamīmin"]],"68:12":[["مَّنَّاعٍۢ","A preventer","mannāʿin"],["لِّلْخَيْرِ","of (the) good","lil'khayri"],["مُعْتَدٍ","transgressor","mu