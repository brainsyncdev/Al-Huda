{"100:1":[["وَٱلْعَـٰدِيَـٰتِ","By the racers","wal-ʿādiyāti"],["ضَبْحًۭا","panting","ḍabḥan"]],"100:2":[["فَٱلْمُورِيَـٰتِ","And the producers of sparks","fal-mūriyāti"],["قَدْحًۭا","striking","qadḥan"]],"100:3":[["فَٱلْمُغِيرَٰتِ","And the chargers","fal-mughīrāti"],["صُبْحًۭا","(at) dawn","ṣub'ḥan"]],"100:4":[["فَأَثَرْنَ","Then raise","fa-atharna"],["بِهِۦ","thereby","bihi"],["نَقْعًۭا","dust","naqʿan"]],"100:5":[["فَوَسَطْنَ","Then penetrate (in the) center","fawasaṭna"],["بِهِۦ","thereby","bihi"],["جَمْعًا","collectively","jamʿan"]],"100:6":[["إِنَّ","Indeed","inna"],["ٱلْإِنسَـٰنَ","mankind","l-insāna"],["لِرَبِّهِۦ","to his Lord","lirabbihi"],["لَكَنُودٌۭ","(is) surely ungrateful","lakanūdun"]],"100:7":[["وَإِنَّهُۥ","And indeed, he","wa-innahu"],["عَلَىٰ","on","ʿalā"],["ذَٰلِكَ","that","dhālika"],["لَشَهِيدٌۭ","surely (is) a witness","lashahīdun"]],"100:8":[["وَإِنَّهُۥ","And indeed he","wa-innahu"],["لِحُبِّ","in (the) love","liḥubbi"],["ٱلْخَيْرِ","(of) wealth","l-khayri"],["لَشَدِيدٌ","(is) surely intense","lashadīdun"]],"100:9":[["۞ أَفَلَا","But does not","afalā"],["يَعْلَمُ","he know","yaʿlamu"],["إِذَا","when","idhā"],["بُعْثِرَ","will be scattered","buʿ'thira"],["مَا","what","mā"],["فِى","(is) in","fī"],["ٱلْقُبُورِ","the graves","l-qubūri"]],"100:10":[["وَحُصِّلَ","And is made apparent","waḥuṣṣila"],["مَا","what","mā"],["فِى","(is) in","fī"],["ٱلصُّدُورِ","the breasts","l-ṣudūri"]],"100:11":[["إِنَّ","Indeed","inna"],["رَبَّهُم","their Lord","rabbahum"],["بِهِمْ","about them","bihim"],["يَوْمَئِذٍۢ","that Day","yawma-idhin"],["لَّخَبِيرٌۢ","(is) surely All-Aware","lakhabīrun"]]}