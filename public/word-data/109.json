{"109:1":[["قُلْ","Say","qul"],["يَـٰٓأَيُّهَا","O","yāayyuhā"],["ٱلْكَـٰفِرُونَ","disbelievers","l-kāfirūna"]],"109:2":[["لَآ","Not","lā"],["أَعْبُدُ","I worship","aʿbudu"],["مَا","what","mā"],["تَعْبُدُونَ","you worship","taʿbudūna"]],"109:3":[["وَلَآ","And not","walā"],["أَنتُمْ","you","antum"],["عَـٰبِدُونَ","(are) worshippers","ʿābidūna"],["مَآ","(of) what","mā"],["أَعْبُدُ","I worship","aʿbudu"]],"109:4":[["وَلَآ","And not","walā"],["أَنَا۠","I am","anā"],["عَابِدٌۭ","a worshipper","ʿābidun"],["مَّا","(of) what","mā"],["عَبَدتُّمْ","you worship","ʿabadttum"]],"109:5":[["وَلَآ","And not","walā"],["أَنتُمْ","you","antum"],["عَـٰبِدُونَ","(are) worshippers","ʿābidūna"],["مَآ","(of) what","mā"],["أَعْبُدُ","I worship","aʿbudu"]],"109:6":[["لَكُمْ","For you","lakum"],["دِينُكُمْ","(is) your religion","dīnukum"],["وَلِىَ","and for me","waliya"],["دِينِ","(is) my religion","dīni"]]}