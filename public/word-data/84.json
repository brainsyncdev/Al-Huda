{"84:1":[["إِذَا","When","idhā"],["ٱلسَّمَآءُ","the sky","l-samāu"],["ٱنشَقَّتْ","is split asunder","inshaqqat"]],"84:2":[["وَأَذِنَتْ","And has listened","wa-adhinat"],["لِرَبِّهَا","to its Lord","lirabbihā"],["وَحُقَّتْ","and was obligated","waḥuqqat"]],"84:3":[["وَإِذَا","And when","wa-idhā"],["ٱلْأَرْضُ","the earth","l-arḍu"],["مُدَّتْ","is spread","muddat"]],"84:4":[["وَأَلْقَتْ","And has cast out","wa-alqat"],["مَا","what","mā"],["فِيهَا","(is) in it","fīhā"],["وَتَخَلَّتْ","and becomes empty","watakhallat"]],"84:5":[["وَأَذِنَتْ","And has listened","wa-adhinat"],["لِرَبِّهَا","to its Lord","lirabbihā"],["وَحُقَّتْ","and was obligated","waḥuqqat"]],"84:6":[["يَـٰٓأَيُّهَا","O","yāayyuhā"],["ٱلْإِنسَـٰنُ","mankind","l-insānu"],["إِنَّكَ","Indeed, you","innaka"],["كَادِحٌ","(are) laboring","kādiḥun"],["إِلَىٰ","to","ilā"],["رَبِّكَ","your Lord","rabbika"],["كَدْحًۭا","(with) exertion","kadḥan"],["فَمُلَـٰقِيهِ","and you (will) meet Him","famulāqīhi"]],"84:7":[["فَأَمَّا","Then as for","fa-ammā"],["مَنْ","(him) who","man"],["أُوتِىَ","is given","ūtiya"],["كِتَـٰبَهُۥ","his record","kitābahu"],["بِيَمِينِهِۦ","in his right (hand)","biyamīnihi"]],"84:8":[["فَسَوْفَ","Then soon","fasawfa"],["يُحَاسَبُ","his account will be taken","yuḥāsabu"],["حِسَابًۭا","an account","ḥisāban"],["يَسِيرًۭا","easy","yasīran"]],"84:9":[["وَيَنقَلِبُ","And he will return","wayanqalibu"],["إِلَىٰٓ","to","ilā"],["أَهْلِهِۦ","his people","ahlihi"],["مَسْرُورًۭا","happily","masrūran"]],"84:10":[["وَأَمَّا","But as for","wa-ammā"],["مَنْ","(him) who","man"],["أُوتِىَ","is given","ūtiya"],["كِتَـٰبَهُۥ","his record","kitābahu"],["وَرَآءَ","behind","warāa"],["ظَهْرِهِۦ","his back","ẓahrihi"]],"84:11":[["فَسَوْفَ","Then soon","fasawfa"],["يَدْعُوا۟","he will call","yadʿū"],["ثُبُورًۭا","(for) destruction","thubūran"]],"84:12":[["وَيَصْلَىٰ","And he will burn","wayaṣlā"],["سَعِيرًا","(in) a Blaze","saʿīran"]],"84:13":[["إِنَّهُۥ","Indeed, he","innahu"],["كَانَ","had been","kāna"],["فِىٓ","among","fī"],["أَهْلِهِۦ","his people","ahlihi"],["مَسْرُورًا","happy","masrūran"]],"84:14":[["إِنَّهُۥ","Indeed, he","innahu"],["ظَنَّ","(had) thought","ẓanna"],["أَن","that","an"],["لَّن","never","lan"],["يَحُورَ","he would return","yaḥūra"]],"84:15":[["بَلَىٰٓ","Yes","balā"],["إِنَّ","Indeed","inna"],["رَبَّهُۥ","his Lord","rabbahu"],["كَانَ","was","kāna"],["بِهِۦ","of him","bihi"],["بَصِيرًۭا","All-Seer","baṣīran"]],"84:16":[["فَلَآ","But nay","falā"],["أُقْسِمُ","I swear","uq'simu"],["بِٱلشَّفَقِ","by the twilight glow","bil-shafaqi"]],"84:17":[["وَٱلَّيْلِ","And the night","wa-al-layli"],["وَمَا","and what","wamā"],["وَسَقَ","it envelops","wasaqa"]],"84:18":[["وَٱلْقَمَرِ","And the moon","wal-qamari"],["إِذَا","when","idhā"],["ٱتَّسَقَ","it becomes full","ittasaqa"]],"84:19":[["لَتَرْكَبُنَّ","You will surely embark","latarkabunna"],["طَبَقًا","(to) stage","ṭabaqan"],["عَن","from","ʿan"],["طَبَقٍۢ","stage","ṭabaqin"]],"84:20":[["فَمَا","So what","famā"],["لَهُمْ","(is) for them","lahum"],["لَا","not","lā"],["يُؤْمِنُونَ","they believe","yu'minūna"]],"84:21":[["وَإِذَا","And when","wa-idhā"],["قُرِئَ","is recited","quri-a"],["عَلَيْهِمُ","to them","ʿalayhimu"],["ٱلْقُرْءَانُ","the Quran","l-qur'ānu"],["لَا","not","lā"],["يَسْجُدُونَ ۩","they prostrate","yasjudūna"]],"84:22":[["بَلِ","Nay","bali"],["ٱلَّذِينَ","Those who","alladhīna"],["كَفَرُوا۟","disbelieved","kafarū"],["يُكَذِّبُونَ","deny","yukadhibūna"]],"84:23":[["وَٱللَّهُ","And Allah","wal-lahu"],["أَعْلَمُ","(is) most knowing","aʿlamu"],["بِمَا","of what","bimā"],["يُوعُونَ","they keep within themselves","yūʿūna"]],"84:24":[["فَبَشِّرْهُم","so give them tidings","fabashir'hum"],["بِعَذَابٍ","of a punishment","biʿadhābin"],["أَلِيمٍ","painful","alīmin"]],"84:25":[["إِلَّا","Except","illā"],["ٱلَّذِينَ","those who","alladhīna"],["ءَامَنُوا۟","believe","āmanū"],["وَعَمِلُوا۟","and do","waʿamilū"],["ٱلصَّـٰلِحَـٰتِ","righteous deeds","l-ṣāliḥāti"],["لَهُمْ","For them","lahum"],["أَجْرٌ","(is) a reward","ajrun"],["غَيْرُ","never","ghayru"],["مَمْنُونٍۭ","ending","mamnūnin"]]}