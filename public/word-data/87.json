{"87:1":[["سَبِّحِ","Glorify","sabbiḥi"],["ٱسْمَ","(the) name","is'ma"],["رَبِّكَ","(of) your Lord","rabbika"],["ٱلْأَعْلَى","the Most High","l-aʿlā"]],"87:2":[["ٱلَّذِى","The One Who","alladhī"],["خَلَقَ","created","khalaqa"],["فَسَوَّىٰ","then proportioned","fasawwā"]],"87:3":[["وَٱلَّذِى","And the One Who","wa-alladhī"],["قَدَّرَ","measured","qaddara"],["فَهَدَىٰ","then guided","fahadā"]],"87:4":[["وَٱلَّذِىٓ","And the One Who","wa-alladhī"],["أَخْرَجَ","brings forth","akhraja"],["ٱلْمَرْعَىٰ","the pasture","l-marʿā"]],"87:5":[["فَجَعَلَهُۥ","And then makes it","fajaʿalahu"],["غُثَآءً","stubble","ghuthāan"],["أَحْوَىٰ","dark","aḥwā"]],"87:6":[["سَنُقْرِئُكَ","We will make you recite","sanuq'ri-uka"],["فَلَا","so not","falā"],["تَنسَىٰٓ","you will forget","tansā"]],"87:7":[["إِلَّا","Except","illā"],["مَا","what","mā"],["شَآءَ","wills","shāa"],["ٱللَّهُ ۚ","Allah","l-lahu"],["إِنَّهُۥ","Indeed, He","innahu"],["يَعْلَمُ","knows","yaʿlamu"],["ٱلْجَهْرَ","the manifest","l-jahra"],["وَمَا","and what","wamā"],["يَخْفَىٰ","is hidden","yakhfā"]],"87:8":[["وَنُيَسِّرُكَ","And We will ease you","wanuyassiruka"],["لِلْيُسْرَىٰ","to the ease","lil'yus'rā"]],"87:9":[["فَذَكِّرْ","So remind","fadhakkir"],["إِن","if","in"],["نَّفَعَتِ","benefits","nafaʿati"],["ٱلذِّكْرَىٰ","the reminder","l-dhik'rā"]],"87:10":[["سَيَذَّكَّرُ","He will pay heed ","sayadhakkaru"],["مَن","(one) who","man"],["يَخْشَىٰ","fears (Allah)","yakhshā"]],"87:11":[["وَيَتَجَنَّبُهَا","And will avoid it","wayatajannabuhā"],["ٱلْأَشْقَى","the wretched one","l-ashqā"]],"87:12":[["ٱلَّذِى","The one who","alladhī"],["يَصْلَى","will burn","yaṣlā"],["ٱلنَّارَ","(in) the Fire","l-nāra"],["ٱلْكُبْرَىٰ","[the] great","l-kub'rā"]],"87:13":[["ثُمَّ","Then","thumma"],["لَا","not","lā"],["يَمُوتُ","he will die","yamūtu"],["فِيهَا","therein","fīhā"],["وَلَا","and not","walā"],["يَحْيَىٰ","will live","yaḥyā"]],"87:14":[["قَدْ","Certainly","qad"],["أَفْلَحَ","has succeeded","aflaḥa"],["مَن","(one) who","man"],["تَزَكَّىٰ","purifies (himself)","tazakkā"]],"87:15":[["وَذَكَرَ","And remembers","wadhakara"],["ٱسْمَ","(the) name","is'ma"],["رَبِّهِۦ","(of) his Lord","rabbihi"],["فَصَلَّىٰ","and prays","faṣallā"]],"87:16":[["بَلْ","Nay","bal"],["تُؤْثِرُونَ","You prefer","tu'thirūna"],["ٱلْحَيَوٰةَ","the life","l-ḥayata"],["ٱلدُّنْيَا","(of) the world","l-dun'yā"]],"87:17":[["وَٱلْـَٔاخِرَةُ","While the Hereafter","wal-ākhiratu"],["خَيْرٌۭ","(is) better","khayrun"],["وَأَبْقَىٰٓ","and everlasting","wa-abqā"]],"87:18":[["إِنَّ","Indeed","inna"],["هَـٰذَا","this","hādhā"],["لَفِى","surely (is) in","lafī"],["ٱلصُّحُفِ","the Scriptures","l-ṣuḥufi"],["ٱلْأُولَىٰ","[the] former","l-ūlā"]],"87:19":[["صُحُفِ","(The) Scriptures","ṣuḥufi"],["إِبْرَٰهِيمَ","(of) Ibrahim","ib'rāhīma"],["وَمُوسَىٰ","and Musa","wamūsā"]]}