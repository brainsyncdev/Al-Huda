{"75:1":[["لَآ","Nay","lā"],["أُقْسِمُ","I swear","uq'simu"],["بِيَوْمِ","by (the) Day","biyawmi"],["ٱلْقِيَـٰمَةِ","(of) the Resurrection","l-qiyāmati"]],"75:2":[["وَلَآ","And nay","walā"],["أُقْسِمُ","I swear","uq'simu"],["بِٱلنَّفْسِ","by the soul","bil-nafsi"],["ٱللَّوَّامَةِ","self-accusing","l-lawāmati"]],"75:3":[["أَيَحْسَبُ","Does think","ayaḥsabu"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["أَلَّن","that not","allan"],["نَّجْمَعَ","We will assemble","najmaʿa"],["عِظَامَهُۥ","his bones","ʿiẓāmahu"]],"75:4":[["بَلَىٰ","Nay","balā"],["قَـٰدِرِينَ","(We are) Able","qādirīna"],["عَلَىٰٓ","on","ʿalā"],["أَن","that","an"],["نُّسَوِّىَ","We can restore","nusawwiya"],["بَنَانَهُۥ","his fingertips","banānahu"]],"75:5":[["بَلْ","Nay","bal"],["يُرِيدُ","Desires","yurīdu"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["لِيَفْجُرَ","to give (the) lie","liyafjura"],["أَمَامَهُۥ","(to) what is before him","amāmahu"]],"75:6":[["يَسْـَٔلُ","He asks","yasalu"],["أَيَّانَ","When","ayyāna"],["يَوْمُ","(is the) Day","yawmu"],["ٱلْقِيَـٰمَةِ","(of) the Resurrection","l-qiyāmati"]],"75:7":[["فَإِذَا","So when","fa-idhā"],["بَرِقَ","is dazzled","bariqa"],["ٱلْبَصَرُ","the vision","l-baṣaru"]],"75:8":[["وَخَسَفَ","And becomes dark","wakhasafa"],["ٱلْقَمَرُ","the moon","l-qamaru"]],"75:9":[["وَجُمِعَ","And are joined","wajumiʿa"],["ٱلشَّمْسُ","the sun","l-shamsu"],["وَٱلْقَمَرُ","and the moon","wal-qamaru"]],"75:10":[["يَقُولُ","Will say","yaqūlu"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["أَيْنَ","Where","ayna"],["ٱلْمَفَرُّ","(is) the escape","l-mafaru"]],"75:11":[["كَلَّا","By no means","kallā"],["لَا","(There is) no","lā"],["وَزَرَ","refuge","wazara"]],"75:12":[["إِلَىٰ","To","ilā"],["رَبِّكَ","your Lord","rabbika"],["يَوْمَئِذٍ","that Day","yawma-idhin"],["ٱلْمُسْتَقَرُّ","(is) the place of rest","l-mus'taqaru"]],"75:13":[["يُنَبَّؤُا۟","Will be informed","yunabba-u"],["ٱلْإِنسَـٰنُ","[the] man","l-insānu"],["يَوْمَئِذٍۭ","that Day","yawma-idh