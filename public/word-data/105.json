{"105:1":[["أَلَمْ","Have not","alam"],["تَرَ","you seen","tara"],["كَيْفَ","how","kayfa"],["فَعَلَ","dealt","faʿala"],["رَبُّكَ","your Lord","rabbuka"],["بِأَصْحَـٰبِ","with (the) Companions","bi-aṣḥābi"],["ٱلْفِيلِ","(of the) Elephant","l-fīli"]],"105:2":[["أَلَمْ","Did not","alam"],["يَجْعَلْ","He make","yajʿal"],["كَيْدَهُمْ","their plan","kaydahum"],["فِى","go","fī"],["تَضْلِيلٍۢ","astray","taḍlīlin"]],"105:3":[["وَأَرْسَلَ","And He sent","wa-arsala"],["عَلَيْهِمْ","against them","ʿalayhim"],["طَيْرًا","birds","ṭayran"],["أَبَابِيلَ","(in) flocks","abābīla"]],"105:4":[["تَرْمِيهِم","Striking them","tarmīhim"],["بِحِجَارَةٍۢ","with stones","biḥijāratin"],["مِّن","of","min"],["سِجِّيلٍۢ","baked clay","sijjīlin"]],"105:5":[["فَجَعَلَهُمْ","Then He made them","fajaʿalahum"],["كَعَصْفٍۢ","like straw","kaʿaṣfin"],["مَّأْكُولٍۭ","eaten up","makūlin"]]}