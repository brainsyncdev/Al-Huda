{"104:1":[["وَيْلٌۭ","Woe","waylun"],["لِّكُلِّ","to every","likulli"],["هُمَزَةٍۢ","slanderer","humazatin"],["لُّمَزَةٍ","backbiter","lumazatin"]],"104:2":[["ٱلَّذِى","The one who","alladhī"],["جَمَعَ","collects","jamaʿa"],["مَالًۭا","wealth","mālan"],["وَعَدَّدَهُۥ","and counts it","waʿaddadahu"]],"104:3":[["يَحْسَبُ","Thinking","yaḥsabu"],["أَنَّ","that","anna"],["مَالَهُۥٓ","his wealth","mālahu"],["أَخْلَدَهُۥ","will make him immortal","akhladahu"]],"104:4":[["كَلَّا ۖ","Nay","kallā"],["لَيُنۢبَذَنَّ","Surely he will be thrown","layunbadhanna"],["فِى","in","fī"],["ٱلْحُطَمَةِ","the Crusher","l-ḥuṭamati"]],"104:5":[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","will make you know","adrāka"],["مَا","what","mā"],["ٱلْحُطَمَةُ","the Crusher (is)","l-ḥuṭamatu"]],"104:6":[["نَارُ","A Fire","nāru"],["ٱللَّهِ","Allah","l-lahi"],["ٱلْمُوقَدَةُ","kindled","l-mūqadatu"]],"104:7":[["ٱلَّتِى","Which","allatī"],["تَطَّلِعُ","mounts up","taṭṭaliʿu"],["عَلَى","to","ʿalā"],["ٱلْأَفْـِٔدَةِ","the hearts","l-afidati"]],"104:8":[["إِنَّهَا","Indeed, it","innahā"],["عَلَيْهِم","(will be) upon them","ʿalayhim"],["مُّؤْصَدَةٌۭ","closed over","mu'ṣadatun"]],"104:9":[["فِى","In","fī"],["عَمَدٍۢ","columns","ʿamadin"],["مُّمَدَّدَةٍۭ","extended","mumaddadatin"]]}