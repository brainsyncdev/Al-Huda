{"89:1":[["وَٱلْفَجْرِ","By the dawn","wal-fajri"]],"89:2":[["وَلَيَالٍ","And the nights","walayālin"],["عَشْرٍۢ","ten","ʿashrin"]],"89:3":[["وَٱلشَّفْعِ","And the even","wal-shafʿi"],["وَٱلْوَتْرِ","and the odd","wal-watri"]],"89:4":[["وَٱلَّيْلِ","And the night","wa-al-layli"],["إِذَا","when","idhā"],["يَسْرِ","it passes","yasri"]],"89:5":[["هَلْ","Is","hal"],["فِى","in","fī"],["ذَٰلِكَ","that","dhālika"],["قَسَمٌۭ","(not) an oath","qasamun"],["لِّذِى","for those","lidhī"],["حِجْرٍ","who understand","ḥij'rin"]],"89:6":[["أَلَمْ","Did not","alam"],["تَرَ","you see","tara"],["كَيْفَ","how","kayfa"],["فَعَلَ","dealt","faʿala"],["رَبُّكَ","your Lord","rabbuka"],["بِعَادٍ","with Aad","biʿādin"]],"89:7":[["إِرَمَ","Iram","irama"],["ذَاتِ","possessors (of)","dhāti"],["ٱلْعِمَادِ","lofty pillars","l-ʿimādi"]],"89:8":[["ٱلَّتِى","Which","allatī"],["لَمْ","not","lam"],["يُخْلَقْ","had been created","yukh'laq"],["مِثْلُهَا","like them","mith'luhā"],["فِى","in","fī"],["ٱلْبِلَـٰدِ","the cities","l-bilādi"]],"89:9":[["وَثَمُودَ","And Thamud","wathamūda"],["ٱلَّذِينَ","who","alladhīna"],["جَابُوا۟","carved out","jābū"],["ٱلصَّخْرَ","the rocks","l-ṣakhra"],["بِٱلْوَادِ","in the valley","bil-wādi"]],"89:10":[["وَفِرْعَوْنَ","And Firaun","wafir'ʿawna"],["ذِى","owner of","dhī"],["ٱلْأَوْتَادِ","stakes","l-awtādi"]],"89:11":[["ٱلَّذِينَ","Who","alladhīna"],["طَغَوْا۟","transgressed","ṭaghaw"],["فِى","in","fī"],["ٱلْبِلَـٰدِ","the lands","l-bilādi"]],"89:12":[["فَأَكْثَرُوا۟","And (made) much","fa-aktharū"],["فِيهَا","therein","fīhā"],["ٱلْفَسَادَ","corruption","l-fasāda"]],"89:13":[["فَصَبَّ","So poured","faṣabba"],["عَلَيْهِمْ","on them","ʿalayhim"],["رَبُّكَ","your Lord","rabbuka"],["سَوْطَ","scourge","sawṭa"],["عَذَابٍ","(of) punishment","ʿadhābin"]],"89:14":[["إِنَّ","Indeed","inna"],["رَبَّكَ","your Lord","rabbaka"],["لَبِٱلْمِرْصَادِ","(is) surely Ever Watchful","labil-mir'ṣādi"]],"89:15":[["فَأَمَّا","And as for","fa-ammā"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["إِذَا","when","idhā"],["مَا","does","mā"],["ٱبْتَلَىٰهُ","try him","ib'talāhu"],["رَبُّهُۥ","his Lord","rabbuhu"],["فَأَكْرَمَهُۥ","and is generous to him","fa-akramahu"],["وَنَعَّمَهُۥ","and favors him","wanaʿʿamahu"],["فَيَقُولُ","he says","fayaqūlu"],["رَبِّىٓ","My Lord","rabbī"],["أَكْرَمَنِ","has honored me","akramani"]],"89:16":[["وَأَمَّآ","But","wa-ammā"],["إِذَا","when","idhā"],["مَا","does","mā"],["ٱبْتَلَىٰهُ","He try him","ib'talāhu"],["فَقَدَرَ","and restricts","faqadara"],["عَلَيْهِ","for him","ʿalayhi"],["رِزْقَهُۥ","his provision","riz'qahu"],["فَيَقُولُ","then he says","fayaqūlu"],["رَبِّىٓ","My Lord","rabbī"],["أَهَـٰنَنِ","(has) humiliated me","ahānani"]],"89:17":[["كَلَّا ۖ","Nay","kallā"],["بَل","But","bal"],["لَّا","not","lā"],["تُكْرِمُونَ","you honor","tuk'rimūna"],["ٱلْيَتِيمَ","the orphan","l-yatīma"]],"89:18":[["وَلَا","And not","walā"],["تَحَـٰٓضُّونَ","you feel the urge","taḥāḍḍūna"],["عَلَىٰ","to","ʿalā"],["طَعَامِ","feed","ṭaʿāmi"],["ٱلْمِسْكِينِ","the poor","l-mis'kīni"]],"89:19":[["وَتَأْكُلُونَ","And you consume","watakulūna"],["ٱلتُّرَاثَ","the inheritance","l-turātha"],["أَكْلًۭا","devouring","aklan"],["لَّمًّۭا","altogether","lamman"]],"89:20":[["وَتُحِبُّونَ","And you love","watuḥibbūna"],["ٱلْمَالَ","wealth","l-māla"],["حُبًّۭا","(with) love","ḥubban"],["جَمًّۭا","immense","jamman"]],"89:21":[["كَلَّآ","Nay","kallā"],["إِذَا","When","idhā"],["دُكَّتِ","is leveled","dukkati"],["ٱلْأَرْضُ","the earth","l-arḍu"],["دَكًّۭا","pounded","dakkan"],["دَكًّۭا","(and) crushed","dakkan"]],"89:22":[["وَجَآءَ","And comes","wajāa"],["رَبُّكَ","your Lord","rabbuka"],["وَٱلْمَلَكُ","and the Angels","wal-malaku"],["صَفًّۭا","rank","ṣaffan"],["صَفًّۭا","(upon) rank","ṣaffan"]],"89:23":[["وَجِا۟ىٓءَ","And is brought","wajīa"],["يَوْمَئِذٍۭ","that Day","yawma-idhin"],["بِجَهَنَّمَ ۚ","Hell","bijahannama"],["يَوْمَئِذٍۢ","That Day","yawma-idhin"],["يَتَذَكَّرُ","will remember","yatadhakkaru"],["ٱلْإِنسَـٰنُ","man","l-insānu"],["وَأَنَّىٰ","but how","wa-annā"],["لَهُ","(will be) for him","lahu"],["ٱلذِّكْرَىٰ","the remembrance","l-dhik'rā"]],"89:24":[["يَقُولُ","He will say","yaqūlu"],["يَـٰلَيْتَنِى","O I wish","yālaytanī"],["قَدَّمْتُ","I had sent forth","qaddamtu"],["لِحَيَاتِى","for my life","liḥayātī"]],"89:25":[["فَيَوْمَئِذٍۢ","So that Day","fayawma-idhin"],["لَّا","not","lā"],["يُعَذِّبُ","will punish","yuʿadhibu"],["عَذَابَهُۥٓ","(as) His punishment","ʿadhābahu"],["أَحَدٌۭ","anyone","aḥadun"]],"89:26":[["وَلَا","And not","walā"],["يُوثِقُ","will bind","yūthiqu"],["وَثَاقَهُۥٓ","(as) His binding","wathāqahu"],["أَحَدٌۭ","anyone","aḥadun"]],"89:27":[["يَـٰٓأَيَّتُهَا","O","yāayyatuhā"],["ٱلنَّفْسُ","soul","l-nafsu"],["ٱلْمُطْمَئِنَّةُ","who is satisfied","l-muṭ'ma-inatu"]],"89:28":[["ٱرْجِعِىٓ","Return","ir'jiʿī"],["إِلَىٰ","to","ilā"],["رَبِّكِ","your Lord","rabbiki"],["رَاضِيَةًۭ","well pleased","rāḍiyatan"],["مَّرْضِيَّةًۭ","and pleasing","marḍiyyatan"]],"89:29":[["فَٱدْخُلِى","So enter","fa-ud'khulī"],["فِى","among","fī"],["عِبَـٰدِى","My slaves","ʿibādī"]],"89:30":[["وَٱدْخُلِى","And enter","wa-ud'khulī"],["جَنَّتِى","My Paradise","jannatī"]]}