{"93:1":[["وَٱلضُّحَىٰ","By the morning brightness","wal-ḍuḥā"]],"93:2":[["وَٱلَّيْلِ","And the night","wa-al-layli"],["إِذَا","when","idhā"],["سَجَىٰ","it covers with darkness","sajā"]],"93:3":[["مَا","Not","mā"],["وَدَّعَكَ","has forsaken you","waddaʿaka"],["رَبُّكَ","your Lord","rabbuka"],["وَمَا","and not","wamā"],["قَلَىٰ","He is displeased","qalā"]],"93:4":[["وَلَلْـَٔاخِرَةُ","And surely the Hereafter","walalākhiratu"],["خَيْرٌۭ","(is) better","khayrun"],["لَّكَ","for you","laka"],["مِنَ","than","mina"],["ٱلْأُولَىٰ","the first","l-ūlā"]],"93:5":[["وَلَسَوْفَ","And soon","walasawfa"],["يُعْطِيكَ","will give you","yuʿ'ṭīka"],["رَبُّكَ","your Lord","rabbuka"],["فَتَرْضَىٰٓ","then you will be satisfied","fatarḍā"]],"93:6":[["أَلَمْ","Did not","alam"],["يَجِدْكَ","He find you","yajid'ka"],["يَتِيمًۭا","an orphan","yatīman"],["فَـَٔاوَىٰ","and give shelter","faāwā"]],"93:7":[["وَوَجَدَكَ","And He found you","wawajadaka"],["ضَآلًّۭا","lost","ḍāllan"],["فَهَدَىٰ","so He guided","fahadā"]],"93:8":[["وَوَجَدَكَ","And He found you","wawajadaka"],["عَآئِلًۭا","in need","ʿāilan"],["فَأَغْنَىٰ","so He made self-sufficient","fa-aghnā"]],"93:9":[["فَأَمَّا","So as for","fa-ammā"],["ٱلْيَتِيمَ","the orphan","l-yatīma"],["فَلَا","then (do) not","falā"],["تَقْهَرْ","oppress","taqhar"]],"93:10":[["وَأَمَّا","And as for","wa-ammā"],["ٱلسَّآئِلَ","one who asks","l-sāila"],["فَلَا","then (do) not","falā"],["تَنْهَرْ","repel","tanhar"]],"93:11":[["وَأَمَّا","But as for","wa-ammā"],["بِنِعْمَةِ","(the) Favor","biniʿ'mati"],["رَبِّكَ","(of) your Lord","rabbika"],["فَحَدِّثْ","narrate","faḥaddith"]]}