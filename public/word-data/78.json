{"78:1":[["عَمَّ","About what","ʿamma"],["يَتَسَآءَلُونَ","are they asking one another","yatasāalūna"]],"78:2":[["عَنِ","About","ʿani"],["ٱلنَّبَإِ","the News","l-naba-i"],["ٱلْعَظِيمِ","the Great","l-ʿaẓīmi"]],"78:3":[["ٱلَّذِى","(About) which","alladhī"],["هُمْ","they","hum"],["فِيهِ","(are) concerning it","fīhi"],["مُخْتَلِفُونَ","(in) disagreement","mukh'talifūna"]],"78:4":[["كَلَّا","Nay","kallā"],["سَيَعْلَمُونَ","(soon) they will know","sayaʿlamūna"]],"78:5":[["ثُمَّ","Then","thumma"],["كَلَّا","Nay","kallā"],["سَيَعْلَمُونَ","(soon) they will know","sayaʿlamūna"]],"78:6":[["أَلَمْ","Have not","alam"],["نَجْعَلِ","We made","najʿali"],["ٱلْأَرْضَ","the earth","l-arḍa"],["مِهَـٰدًۭا","a resting place","mihādan"]],"78:7":[["وَٱلْجِبَالَ","And the mountains","wal-jibāla"],["أَوْتَادًۭا","(as) pegs","awtādan"]],"78:8":[["وَخَلَقْنَـٰكُمْ","And We created you","wakhalaqnākum"],["أَزْوَٰجًۭا","(in) pairs","azwājan"]],"78:9":[["وَجَعَلْنَا","And We made","wajaʿalnā"],["نَوْمَكُمْ","your sleep","nawmakum"],["سُبَاتًۭا","(for) rest","subātan"]],"78:10":[["وَجَعَلْنَا","And We made","wajaʿalnā"],["ٱلَّيْلَ","the night","al-layla"],["لِبَاسًۭا","(as) covering","libāsan"]],"78:11":[["وَجَعَلْنَا","And We made","wajaʿalnā"],["ٱلنَّهَارَ","the day","l-nahāra"],["مَعَاشًۭا","(for) livelihood","maʿāshan"]],"78:12":[["وَبَنَيْنَا","And We constructed","wabanaynā"],["فَوْقَكُمْ","over you","fawqakum"],["سَبْعًۭا","seven","sabʿan"],["شِدَادًۭا","strong","shidādan"]],"78:13":[["وَجَعَلْنَا","And We placed","wajaʿalnā"],["سِرَاجًۭا","a lamp","sirājan"],["وَهَّاجًۭا","burning","wahhājan"]],"78:14":[["وَأَنزَلْنَا","And We sent down","wa-anzalnā"],["مِنَ","from","mina"],["ٱلْمُعْصِرَٰتِ","the rain clouds","l-muʿ'ṣirāti"],["مَآءًۭ","water","māan"],["ثَجَّاجًۭا","pouring abundantly","thajjājan"]],"78:15":[["لِّنُخْرِجَ","That We may bring forth","linukh'rija"],["بِهِۦ","thereby","bihi"],["حَبًّۭا","grain","ḥabban"],["وَنَبَاتًۭا","and vegetation","wanabātan"]],"78:16":[["وَجَنَّـٰتٍ