{"101:1":[["ٱلْقَارِعَةُ","The Striking Calamity","al-qāriʿatu"]],"101:2":[["مَا","What","mā"],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu"]],"101:3":[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","will make you know","adrāka"],["مَا","what","mā"],["ٱلْقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu"]],"101:4":[["يَوْمَ","(The) Day","yawma"],["يَكُونُ","will be","yakūnu"],["ٱلنَّاسُ","the mankind","l-nāsu"],["كَٱلْفَرَاشِ","like moths","kal-farāshi"],["ٱلْمَبْثُوثِ","scattered","l-mabthūthi"]],"101:5":[["وَتَكُونُ","And will be","watakūnu"],["ٱلْجِبَالُ","the mountains","l-jibālu"],["كَٱلْعِهْنِ","like wool","kal-ʿih'ni"],["ٱلْمَنفُوشِ","fluffed up","l-manfūshi"]],"101:6":[["فَأَمَّا","Then as for","fa-ammā"],["مَن","(him) whose","man"],["ثَقُلَتْ","(are) heavy","thaqulat"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu"]],"101:7":[["فَهُوَ","Then he","fahuwa"],["فِى","(will be) in","fī"],["عِيشَةٍۢ","a life","ʿīshatin"],["رَّاضِيَةٍۢ","pleasant","rāḍiyatin"]],"101:8":[["وَأَمَّا","But as for","wa-ammā"],["مَنْ","(him) whose","man"],["خَفَّتْ","(are) light","khaffat"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu"]],"101:9":[["فَأُمُّهُۥ","His abode","fa-ummuhu"],["هَاوِيَةٌۭ","(will be the) Pit","hāwiyatun"]],"101:10":[["وَمَآ","And what","wamā"],["أَدْرَىٰكَ","will make you know","adrāka"],["مَا","what","mā"],["هِيَهْ","it is","hiyah"]],"101:11":[["نَارٌ","A Fire","nārun"],["حَامِيَةٌۢ","intensely hot","ḥāmiyatun"]]}