  "conceptDerivationStrategy": {
    "approach": "extract-from-topics",
    "description": "Concepts do not exist in legacy data. They must be derived by analyzing existing topics and identifying the underlying abstract semantic units. For example, topic 'tawheed-fundamentals' expresses concept 'cpt-divine-unity'. Multiple topics may express the same concept.",
    "steps": [
      "1. Cluster existing topics by shared relatedTopicIds and overlapping ayahMappings",
      "2. For each cluster, identify the abstract semantic kernel (e.g., 'mercy', 'justice', 'monotheism')",
      "3. Create Concept entities with cpt-{slug} IDs",
      "4. Link Topics to Concepts via Topic.conceptIds and Relationship(type=EXPRESSES)",
      "5. Existing topic IDs remain unchanged (with 'topic-' prefix added); they do NOT become concepts"
    ],
    "riskNote": "This is a scholarly task, not a mechanical one. Automated extraction will produce candidate concepts requiring human review."
  },
  "relationshipTypeMapping": {
    "CONTAINS": "CONTAINS (direct match)",
    "CROSS_REFERENCES": "CROSS_REFERENCES (direct match, maps to canonical enum)",
    "SHARES_CONCEPT": "RELATED or CUSTOM(customType='SHARES_CONCEPT') — canonical model uses RELATED for general association; SHARES_CONCEPT semantics better served by explicit Concept entities with EXPRESSES relationships"
