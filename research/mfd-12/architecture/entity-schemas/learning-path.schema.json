{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/learning-path",
  "title": "MFD-12 LearningPath",
  "description": "Ordered sequence of learning modules for structured study.",
  "type": "object",
  "required": ["id", "title", "moduleIds", "createdBy", "visibility", "createdAt", "updatedAt", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "moduleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" }, "description": "Ordered sequence of LearningModule.id" },
    "targetAudience": { "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED", "SCHOLAR"] },
    "estimatedHours": { "type": "number", "exclusiveMinimum": 0 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "createdBy": { "type": "string", "minLength": 1 },
    "visibility": { "enum": ["PRIVATE", "SHARED", "PUBLIC"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 }
  }
}
