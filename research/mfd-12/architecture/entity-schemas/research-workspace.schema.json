{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/research-workspace",
  "title": "MFD-12 ResearchWorkspace",
  "description": "Named investigation context for organizing research activities.",
  "type": "object",
  "required": ["id", "name", "ownerUserId", "createdAt", "updatedAt", "schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ws-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ownerUserId": { "type": "string", "minLength": 1 },
    "memberUserIds": { "type": "array", "items": { "type": "string" } },
    "entityReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entityType", "entityId", "addedAt"],
        "additionalProperties": false,
        "properties": {
          "entityType": { "type": "string", "minLength": 1 },
          "entityId": { "type": "string", "minLength": 1 },
          "addedAt": { "type": "string", "format": "date-time" },
          "note": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 }
  }
}
