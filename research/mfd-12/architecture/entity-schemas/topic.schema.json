{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/topic",
  "title": "MFD-12 Topic",
  "description": "Curated thematic subject with explicit taxonomy placement. Extends existing taxonomy structure.",
  "type": "object",
  "required": ["id", "titleEn", "description", "parentDomainId", "specialized", "ayahMappings", "provenance", "reviewStatus", "createdAt", "updatedAt", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^topic-[a-z0-9-]+$" },
    "titleEn": { "type": "string", "minLength": 1 },
    "titleAr": { "type": "string" },
    "titleUr": { "type": "string" },
    "description": { "type": "string", "minLength": 1, "description": "Scope description" },
    "conceptIds": { "type": "array", "items": { "type": "string", "pattern": "^cpt-[a-z0-9-]+$" } },
    "parentDomainId": { "type": "string", "pattern": "^dom-[a-z0-9-]+$" },
    "parentDimensionId": { "type": "string", "pattern": "^dim-[a-z0-9-]+$" },
    "parentSubdimensionId": { "type": "string" },
    "relatedTopicIds": { "type": "array", "items": { "type": "string", "pattern": "^topic-[a-z0-9-]+$" } },
    "searchAliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "specialized": { "type": "boolean" },
    "ayahMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verseId", "mappingType", "rationale", "evidenceClass"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verseId": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
          "mappingType": { "enum": ["DIRECT_REFERENCE", "THEMATIC", "CONTEXTUAL"] },
          "rationale": { "type": "string", "minLength": 1 },
          "evidenceClass": { "enum": ["EXPLICIT_TEXT", "THEMATIC", "CONTEXTUAL"] },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "method", "assertedAt", "assertedBy"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "corpusVersion": { "type": "string" },
        "assertedAt": { "type": "string", "format": "date-time" },
        "assertedBy": { "type": "string", "minLength": 1 }
      }
    },
    "reviewStatus": { "enum": ["DRAFT", "PENDING_SCHOLARLY_REVIEW", "APPROVED", "REVISED", "DEPRECATED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 }
  }
}
