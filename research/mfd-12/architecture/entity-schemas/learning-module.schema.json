{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/learning-module",
  "title": "MFD-12 LearningModule",
  "description": "Self-contained educational unit.",
  "type": "object",
  "required": ["id", "title", "contentType", "contentBody", "createdBy", "createdAt", "updatedAt", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "contentType": { "enum": ["TEXT", "INTERACTIVE", "QUIZ", "MULTIMEDIA", "MIXED"] },
    "contentBody": { "type": "string", "minLength": 1, "description": "Markdown or structured content" },
    "topicIds": { "type": "array", "items": { "type": "string", "pattern": "^topic-[a-z0-9-]+$" } },
    "conceptIds": { "type": "array", "items": { "type": "string", "pattern": "^cpt-[a-z0-9-]+$" } },
    "prerequisites": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "difficultyLevel": { "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"] },
    "estimatedMinutes": { "type": "integer", "exclusiveMinimum": 0 },
    "createdBy": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 }
  }
}
