{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/lemma",
  "title": "MFD-12 Lemma",
  "description": "Specific morphological form as it occurs in the corpus. Derived from verified root-occurrences data.",
  "type": "object",
  "required": ["id", "lexicalEntryId", "rootAnalysisId", "formArabic", "formTransliterated", "partOfSpeech", "occurrences", "totalOccurrences", "distinctAyahCount", "corpusVersion", "schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^lem-[a-z]+-[a-z0-9]+$", "description": "Root + form code composite" },
    "lexicalEntryId": { "type": "string", "pattern": "^lex-[a-z0-9-]+$" },
    "rootAnalysisId": { "type": "string", "format": "uuid" },
    "formArabic": { "type": "string", "minLength": 1, "description": "Exact diacritical form" },
    "formTransliterated": { "type": "string", "minLength": 1, "description": "ISO 233-2" },
    "partOfSpeech": { "enum": ["VERB", "NOUN", "ADJECTIVE", "PARTICIPLE", "PARTICLE", "PRONOUN", "OTHER"] },
    "occurrences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["verseId", "wordPosition", "matchedToken"],
        "additionalProperties": false,
        "properties": {
          "verseId": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
          "wordPosition": { "type": "integer", "minimum": 0 },
          "matchedToken": { "type": "string", "minLength": 1 }
        }
      }
    },
    "totalOccurrences": { "type": "integer", "minimum": 1, "description": "Count of occurrences array" },
    "distinctAyahCount": { "type": "integer", "minimum": 1, "description": "Unique surah:ayah pairs" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string", "minLength": 1 }
  }
}
