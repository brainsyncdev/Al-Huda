{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/dimension",
  "title": "MFD-12 Dimension",
  "description": "Mid-level taxonomy grouping beneath Domain.",
  "type": "object",
  "required": ["id", "titleEn", "description", "parentDomainId", "provenance", "reviewStatus", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^dim-[a-z0-9-]+$" },
    "titleEn": { "type": "string", "minLength": 1 },
    "titleAr": { "type": "string" },
    "titleUr": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "parentDomainId": { "type": "string", "pattern": "^dom-[a-z0-9-]+$" },
    "subdimensionIds": { "type": "array", "items": { "type": "string" } },
    "topicIds": { "type": "array", "items": { "type": "string", "pattern": "^topic-[a-z0-9-]+$" } },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "required": ["origin", "method", "assertedAt", "assertedBy"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "corpusVersion": { "type": "string" },
        "assertedAt": { "type": "string", "format": "date-time" },
        "assertedBy": { "type": "string", "minLength": 1 }
      }
    },
    "reviewStatus": { "enum": ["DRAFT", "PENDING_SCHOLARLY_REVIEW", "APPROVED", "REVISED", "DEPRECATED"] },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 }
  }
}
