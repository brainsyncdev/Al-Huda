{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/lexical-entry",
  "title": "MFD-12 LexicalEntry",
  "description": "Dictionary entry for a unique lemma. One entry per lemma; polysemy via contextualSenses.",
  "type": "object",
  "required": ["id", "lemmaArabic", "lemmaTransliterated", "rootIds", "primaryRootId", "rootDisputed", "partOfSpeech", "gloss", "contextualSenses", "morphConfidence", "provenance", "reviewStatus", "createdAt", "updatedAt", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^lex-[a-z0-9-]+$", "description": "Deterministic slug from primary lemma" },
    "lemmaArabic": { "type": "string", "minLength": 1, "description": "Citation form with full tashkīl" },
    "lemmaTransliterated": { "type": "string", "minLength": 1, "description": "ISO 233-2 primary transliteration" },
    "searchAliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rootIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "References to RootAnalysis.id; supports disputed roots" },
    "primaryRootId": { "type": "string", "description": "Most widely attested classical analysis; must be in rootIds" },
    "rootDisputed": { "type": "boolean", "description": "True if classical lexicons disagree on root" },
    "partOfSpeech": { "enum": ["VERB", "NOUN", "ADJECTIVE", "PARTICIPLE", "PARTICLE", "PRONOUN", "OTHER"] },
    "gloss": {
      "type": "object",
      "required": ["lexical", "contextualSenses", "editorialGloss"],
      "additionalProperties": false,
      "properties": {
        "lexical": { "type": "string", "minLength": 1, "description": "Core semantic value independent of context" },
        "contextualSenses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sense", "verses"],
            "additionalProperties": false,
            "properties": {
              "sense": { "type": "string", "minLength": 1 },
              "verses": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" } },
              "notes": { "type": "string" }
            }
          }
        },
        "tafsirNote": { "type": "string", "description": "Classical exegetical insight, explicitly labeled" },
        "editorialGloss": { "type": "string", "minLength": 1, "description": "FAHM's proposed classification gloss" }
      }
    },
    "contextualSenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sense", "verses"],
        "additionalProperties": false,
        "properties": {
          "sense": { "type": "string", "minLength": 1 },
          "verses": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "morphConfidence": { "enum": ["HIGH", "MEDIUM", "LOW", "DISPUTED"] },
    "alternativeAnalyses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rootArabic", "proponent", "rationale", "sourceIds"],
        "additionalProperties": false,
        "properties": {
          "rootArabic": { "type": "string" },
          "proponent": { "type": "string" },
          "rationale": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "method", "assertedAt", "assertedBy"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "corpusVersion": { "type": "string" },
        "assertedAt": { "type": "string", "format": "date-time" },
        "assertedBy": { "type": "string", "minLength": 1 }
      }
    },
    "reviewStatus": { "enum": ["DRAFT", "PENDING_SCHOLARLY_REVIEW", "APPROVED", "REVISED", "DEPRECATED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "integer", "minimum": 1, "description": "Monotonically increasing revision counter" }
  }
}
