{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/evidence-record",
  "title": "MFD-12 EvidenceRecord",
  "description": "Verifiable link between a scholarly claim and specific corpus text. Extends MFD-11 evidence-link.",
  "type": "object",
  "required": ["id", "verseId", "excerpt", "evidenceClass", "rationale", "verifiedAgainstCorpus", "corpusVersion", "createdBy", "createdAt", "schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "verseId": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}$" },
    "excerpt": { "type": "string", "minLength": 1, "description": "Verbatim substring of corpus Arabic text" },
    "wordPositions": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "evidenceClass": { "enum": ["EXPLICIT_TEXT", "THEMATIC", "CONTEXTUAL"] },
    "rationale": { "type": "string", "minLength": 1 },
    "claimId": { "type": "string", "format": "uuid" },
    "sourceIds": { "type": "array", "items": { "type": "string", "pattern": "^src-[a-z0-9-]+$" } },
    "verifiedAgainstCorpus": { "type": "boolean", "description": "Mechanically checked against pinned corpus" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "createdBy": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "minLength": 1 }
  }
}
