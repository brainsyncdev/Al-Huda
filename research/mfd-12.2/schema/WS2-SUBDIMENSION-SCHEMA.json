{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mfd-12/subdimension",
  "title": "MFD-12 Subdimension",
  "description": "Fourth-level taxonomy grouping beneath Dimension. Elevated from embedded string references to first-class entity per WS-D Q24 resolution.",
  "type": "object",
  "required": ["id", "titleEn", "description", "parentDimensionId", "provenance", "reviewStatus", "schemaVersion", "contentVersion"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^subdim-[a-z0-9-]+$",
      "description": "Unique identifier with subdim- prefix"
    },
    "titleEn": {
      "type": "string",
      "minLength": 1,
      "description": "English title"
    },
    "titleAr": {
      "type": "string",
      "description": "Arabic title with tashkīl"
    },
    "titleUr": {
      "type": "string",
      "description": "Urdu title in Urdu script"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Scope description of this subdimension"
    },
    "parentDimensionId": {
      "type": "string",
      "pattern": "^dim-[a-z0-9-]+$",
      "description": "Reference to parent Dimension.id"
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^topic-[a-z0-9-]+$"
      },
      "description": "Direct child topic IDs. Authoritative containment represented by EDITORIAL_CLASSIFICATION edges."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Search aliases for discovery"
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "method", "assertedAt", "assertedBy"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "description": "Process, script, or scholar name"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "How the data was produced"
        },
        "corpusVersion": {
          "type": "string",
          "description": "Pinned corpus version if applicable"
        },
        "assertedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "assertedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Agent identifier"
        }
      },
      "description": "Origin metadata"
    },
    "reviewStatus": {
      "enum": ["DRAFT", "PENDING_SCHOLARLY_REVIEW", "APPROVED", "REVISED", "DEPRECATED"],
      "description": "Current scholarly review state"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Entity schema version (SemVer)"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Content revision counter; monotonically increasing"
    }
  },
  "definitions": {
    "ProvenanceObject": {
      "type": "object",
      "required": ["origin", "method", "assertedAt", "assertedBy"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "corpusVersion": { "type": "string" },
        "assertedAt": { "type": "string", "format": "date-time" },
        "assertedBy": { "type": "string", "minLength": 1 }
      }
    }
  },
  "x-mfd-metadata": {
    "entityGroup": "C",
    "groupName": "Knowledge Taxonomy",
    "mutable": true,
    "curated": true,
    "proposedBy": "ai-assisted",
    "reviewStatus": "pending-review",
    "sourceResolution": "WS-D-SUBDIMENSION-RESOLUTION.md",
    "crossReferenceIntegrityRules": [
      "Subdimension.parentDimensionId → MUST exist in Dimension.id",
      "Subdimension.topicIds[] → Each MUST exist in Topic.id",
      "Dimension.subdimensionIds[] → Each MUST exist in Subdimension.id",
      "Topic.parentSubdimensionId → If present, MUST exist in Subdimension.id"
    ]
  }
}
